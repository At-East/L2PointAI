// Win32 version + icon resource for L2PointAI.exe (ASCII only, no windows.h needed).
1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "L2PointAI"
            VALUE "FileDescription", "L2 Point Cloud AI Analyzer"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "L2PointAI"
            VALUE "LegalCopyright", "Free to use"
            VALUE "OriginalFilename", "L2PointAI.exe"
            VALUE "ProductName", "L2PointAI"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

1 ICON "app.ico"
// application manifest: RT_MANIFEST (24), resource id 1
1 24 "..\\src\\app.manifest"

